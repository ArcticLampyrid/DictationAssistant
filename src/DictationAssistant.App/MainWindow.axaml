<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DictationAssistant.App.ViewModels"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="DictationAssistant.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="{Binding MainWindowWidth, Mode=TwoWay}"
        Height="{Binding MainWindowHeight, Mode=TwoWay}"
        MinWidth="860"
        MinHeight="560"
        Title="自动默写"
        mc:Ignorable="d">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="新建(_N)..." InputGesture="Ctrl+N" Click="NewWordList_Click" />
        <MenuItem Header="打开(_O)..." InputGesture="Ctrl+O" Click="OpenFile_Click" />
        <MenuItem Header="保存(_S)..." InputGesture="Ctrl+S" Click="SaveFile_Click" />
        <Separator />
        <MenuItem Header="退出(_E)" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="编辑(_E)">
        <MenuItem Header="{Binding ShowOrHideWordListText}" Command="{Binding ToggleWordListCommand}" />
        <Separator />
        <MenuItem Header="剪切" InputGesture="Ctrl+X" Click="Cut_Click" />
        <MenuItem Header="复制" InputGesture="Ctrl+C" Click="Copy_Click" />
        <MenuItem Header="粘贴" InputGesture="Ctrl+V" Click="Paste_Click" />
        <Separator />
        <MenuItem Header="全选" InputGesture="Ctrl+A" Click="SelectAll_Click" />
      </MenuItem>
      <MenuItem Header="选项(_O)">
        <MenuItem Header="偏好设置(_P)..." Click="Preference_Click" />
        <Separator />
        <MenuItem Header="自动翻页" ToggleType="CheckBox" IsChecked="{Binding AutoScrollCurrentLine}" />
        <MenuItem Header="高亮跟随" ToggleType="CheckBox" IsChecked="{Binding HighlightCurrentLine}" />
      </MenuItem>
      <MenuItem Header="辅助(_A)">
        <MenuItem Header="保存音频" Click="SaveAudio_Click" />
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="关于(_A)" Click="About_Click" />
      </MenuItem>
    </Menu>

    <DockPanel DockPanel.Dock="Right" Width="264" Margin="8,8,8,8" LastChildFill="True">
      <Border DockPanel.Dock="Top" Margin="0,0,0,8" BorderBrush="#C8C8C8" BorderThickness="1" Padding="6">
        <StackPanel>
          <TextBlock Margin="0,0,0,6" FontWeight="Bold" Text="播报信息" />
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="4" Text="{Binding CurrentRepeat, StringFormat=本词语播报次数：{0}}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="4" VerticalAlignment="Center" Text="自动播报间隔/秒：" />
          <TextBox Grid.Row="1" Grid.Column="1" Margin="4" HorizontalContentAlignment="Right" Text="{Binding IntervalSeconds, Mode=TwoWay}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="4" VerticalAlignment="Center" Text="自动播报次数/词：" />
          <TextBox Grid.Row="2" Grid.Column="1" Margin="4" HorizontalContentAlignment="Right" Text="{Binding TimesPerWord, Mode=TwoWay}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="4" FontSize="20" FontWeight="Bold" Text="{Binding SpeakStateText}" />
        </Grid>
        </StackPanel>
      </Border>

      <Button DockPanel.Dock="Top" Content="{Binding ShowOrHideWordListText}" Command="{Binding ToggleWordListCommand}" Margin="4" Padding="4" />

      <Border DockPanel.Dock="Bottom" Margin="0,8,0,8" BorderBrush="#C8C8C8" BorderThickness="1" Padding="6">
        <StackPanel>
          <TextBlock Margin="0,0,0,6" FontWeight="Bold" Text="引擎设置" />
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="4" VerticalAlignment="Center" Text="音量：" />
          <Slider Grid.Row="0" Grid.Column="1" Margin="4" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="4" VerticalAlignment="Center" Text="语速：" />
          <Slider Grid.Row="1" Grid.Column="1" Margin="4" Minimum="-10" Maximum="10" Value="{Binding Rate, Mode=TwoWay}" />
          <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="4" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="引擎：" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TtsEngineName}" />
            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="语音：" />
            <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0">
              <ComboBoxItem Content="默认语音（占位）" />
            </ComboBox>
          </Grid>
        </Grid>
        </StackPanel>
      </Border>

      <Border Margin="0,8,0,0" BorderBrush="#C8C8C8" BorderThickness="1" Padding="6">
        <StackPanel>
          <TextBlock Margin="0,0,0,6" FontWeight="Bold" Text="播报控制" />
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*">
          <Button Grid.Row="0" Grid.Column="0" Margin="4" Command="{Binding StartAutoCommand}" Content="开始播报(_S)" />
          <Button Grid.Row="0" Grid.Column="1" Margin="4" Command="{Binding StopCommand}" Content="停止播报(_D)" />
          <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="4" FontSize="22" FontWeight="Bold" Content="{Binding PauseOrResumeAutoText}" Command="{Binding PauseOrResumeAutoCommand}" />
          <Button Grid.Row="2" Grid.Column="0" Margin="4" Command="{Binding SpeakNextCommand}" Content="报下一个(_N)" />
          <Button Grid.Row="2" Grid.Column="1" Margin="4" Click="ResetRecord_Click" Content="记录归零(_C)" />
          <Button Grid.Row="3" Grid.Column="0" Margin="4" Command="{Binding SpeakAgainCommand}" Content="再报一遍(_M)" />
          <Button Grid.Row="3" Grid.Column="1" Margin="4" Command="{Binding SpeakPreviousCommand}" Content="报上一个(_L)" />
        </Grid>
        </StackPanel>
      </Border>
    </DockPanel>

    <Border Margin="8" BorderBrush="#C8C8C8" BorderThickness="1" Padding="6" IsVisible="{Binding WordListVisible}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="Bold" Text="词语列表" />
        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Spacing="4" Width="72">
          <Button Content="打开" Click="OpenFile_Click" />
          <Button Content="保存" Click="SaveFile_Click" />
          <Button Content="剪切" Click="Cut_Click" />
          <Button Content="复制" Click="Copy_Click" />
          <Button Content="粘贴" Click="Paste_Click" />
          <Button Content="删除" Click="Delete_Click" />
          <Button Content="新建" Click="NewWordList_Click" />
          <Button Content="计数" Click="Count_Click" />
        </StackPanel>

        <avaloniaEdit:TextEditor x:Name="WordlistEditor"
                                 FontFamily="{Binding EditorFontFamily, Mode=TwoWay}"
                                 FontSize="{Binding EditorFontSize, Mode=TwoWay}"
                                 ShowLineNumbers="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto">
          <avaloniaEdit:TextEditor.ContextMenu>
            <ContextMenu>
              <MenuItem Header="读选定词语" Click="SpeakSelection_Click" />
              <MenuItem Header="在Bing词典中查看" Click="ViewSelectionInBingDictionary_Click" />
              <MenuItem Header="从此处开始自动播报" Click="StartFromSelection_Click" />
              <Separator />
              <MenuItem Header="剪切" Click="Cut_Click" />
              <MenuItem Header="复制" Click="Copy_Click" />
              <MenuItem Header="粘贴" Click="Paste_Click" />
              <Separator />
              <MenuItem Header="全选" Click="SelectAll_Click" />
            </ContextMenu>
          </avaloniaEdit:TextEditor.ContextMenu>
        </avaloniaEdit:TextEditor>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
